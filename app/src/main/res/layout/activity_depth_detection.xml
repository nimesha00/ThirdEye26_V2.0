<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/te_background"
    tools:context=".DepthDetectionActivity">

    <!-- Live camera picture from ARCore. -->
    <android.opengl.GLSurfaceView
        android:id="@+id/depthSurface"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <!-- Yellow boxes with names and distances. -->
    <com.sliit.thirdeye.BoxOverlayView
        android:id="@+id/depthOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:fitsSystemWindows="true"
        android:orientation="vertical">

        <TextView
            style="@style/Widget.ThirdEye.ScreenLabel"
            android:text="@string/live_detection_title" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            android:text="@string/live_detection_hint"
            android:textAppearance="@style/TextAppearance.ThirdEye.Caption" />
    </LinearLayout>

</FrameLayout>

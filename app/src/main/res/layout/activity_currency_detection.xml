<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/te_background"
    tools:context=".CurrencyDetection">

    <ViewStub
        android:id="@+id/object_detection_texture_view_stub"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout="@layout/texture_view" />

    <!-- Yellow boxes around the notes found, for a sighted helper. -->
    <com.sliit.thirdeye.NoteBoxesView
        android:id="@+id/noteBoxes"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <TextView
        style="@style/Widget.ThirdEye.ScreenLabel"
        android:layout_margin="16dp"
        android:fitsSystemWindows="true"
        android:text="@string/note_reader_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- What was found, in large text. Not a live region: results are already spoken. -->
    <TextView
        android:id="@+id/noteResult"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:background="@color/te_scrim"
        android:gravity="center"
        android:minHeight="72dp"
        android:padding="16dp"
        android:text="@string/note_reader_looking"
        android:textColor="@color/te_accent"
        android:textSize="30sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
